# The directory Mix will write compiled artifacts to.
/_build/
/examples/example_app/_build/

# Coverage reports.
/cover/

# Dependency artifacts.
/deps/
/examples/example_app/deps/

# Generated documentation.
/doc/

# Mix archives and local package state.
/.fetch

# Temporary files.
/tmp/

# Crash dumps.
erl_crash.dump

# Dialyzer PLT files.
*.plt
*.plt.hash

# Local environment.
.env
.env.*

# Editor and OS files.
/.elixir_ls/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Codex
.codex
